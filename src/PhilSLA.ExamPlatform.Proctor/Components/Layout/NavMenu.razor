@inject ProctorSessionState ProctorSession
@inject NavigationManager Navigation

<div class="navigation-shell">
    <a class="brand" href="home" aria-label="PhilSLA Proctor Workstation home">
        <img src="images/philsla-mark.svg" alt="" width="40" height="40" />
        <span class="brand-wordmark">Phil<span>SLA</span></span>
    </a>

    <div class="navigation-content">
        <p class="navigation-label">Proctor operations</p>
        <nav class="navigation-links" aria-label="Proctor operations">
            <NavLink class="navigation-link" href="home">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M8 3v4M16 3v4M3 10h18" />
                </svg>
                <span>Exam Schedule</span>
            </NavLink>

            <NavLink class="navigation-link attendance-navigation"
                     href="home"
                     title="Open attendance from an assigned session card"
                     aria-label="Student Attendance — open attendance from an assigned session card">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3 20v-2a5 5 0 0 1 5-5h2a5 5 0 0 1 5 5v2M16 5a3 3 0 0 1 0 6M18 14a5 5 0 0 1 3 4.6V20" />
                </svg>
                <span>Student Attendance</span>
            </NavLink>

            <button class="navigation-link" type="button" disabled title="Room monitoring is not available yet" aria-label="Room Live Monitoring (not available yet)">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="13" rx="2" />
                    <path d="M8 21h8M12 17v4" />
                </svg>
                <span>Room Live Monitoring</span>
            </button>

            <NavLink class="navigation-link incident-navigation" href="incidents">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M12 3l7 3v5c0 4.6-2.9 8-7 10-4.1-2-7-5.4-7-10V6l7-3Z" />
                    <path d="M12 8v5M12 16h.01" />
                </svg>
                <span>Incident Records</span>
            </NavLink>

            <button class="navigation-link" type="button" disabled title="Session records are not available yet" aria-label="Session Record (not available yet)">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <rect x="3" y="6" width="13" height="12" rx="2" />
                    <path d="m16 10 5-3v10l-5-3" />
                </svg>
                <span>Session Record</span>
            </button>
        </nav>
    </div>

    <button class="sign-out-button" type="button" @onclick="SignOut">
        <svg aria-hidden="true" viewBox="0 0 24 24">
            <path d="M10 17l5-5-5-5M15 12H3M14 4h4a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3h-4" />
        </svg>
        <span>Sign Out</span>
    </button>
</div>

@code {
    private void SignOut()
    {
        ProctorSession.SignOut();
        Navigation.NavigateTo("/", replace: true);
    }
}
