@page "/attendance/{SessionId:guid}"
@implements IAsyncDisposable
@inject ProctorSessionState ProctorSession
@inject NavigationManager Navigation
@inject AttendanceService AttendanceService
@inject TimeProvider TimeProvider
@inject IJSRuntime JS

<PageTitle>Student Attendance | PhilSLA Proctor Workstation</PageTitle>

@if (ProctorSession.IsAuthenticated)
{
    <div class="attendance-page">
        @if (_isLoading)
        {
            <p class="attendance-loading" role="status">Loading attendance roster...</p>
        }
        else if (_snapshot is null)
        {
            @if (_pageError is not null)
            {
                <div class="page-error" role="alert">@_pageError</div>
            }
        }
        else
        {
            <header class="attendance-heading">
                <div class="attendance-title-group">
                    <a class="back-link" href="home">Back to assigned sessions</a>
                    <h1>Candidate Attendance</h1>
                    <h2 class="session-heading">@_snapshot.Definition.Title</h2>
                    <p class="session-details">
                        @_snapshot.Definition.Room · @FormatSchedule(_snapshot.Definition)
                    </p>
                </div>
                <button class="end-session"
                        type="button"
                        disabled="@(TimeProvider.GetUtcNow() < _snapshot.Definition.EndsAtUtc ||
                                    _snapshot.IsFinalized ||
                                    _snapshot.PendingCount > 0 ||
                                    _snapshot.UnmarkedCount > 0 ||
                                    _isSubmitting)"
                        @onclick="OpenFinalizationDialog">
                    End session
                </button>
            </header>

            <section class="session-context" aria-label="Session information and scanner availability">
                <dl class="session-facts">
                    <div>
                        <dt>Exam set</dt>
                        <dd>@_snapshot.Definition.ExamSet</dd>
                    </div>
                    <div>
                        <dt>Check-in opens</dt>
                        <dd>@FormatLocalTime(_snapshot.CheckInOpensAtUtc)</dd>
                    </div>
                    <div>
                        <dt>Cutoff</dt>
                        <dd>@FormatLocalTime(_snapshot.CutoffAtUtc)</dd>
                    </div>
                </dl>
                <div class="scanner-control">
                    <button class="connect-scanner"
                            type="button"
                            disabled
                            aria-describedby="scanner-availability">
                        Connect Mobile Scanner
                    </button>
                    <span id="scanner-availability" class="scanner-availability">Not available yet</span>
                </div>
            </section>

            @if (_pageError is not null)
            {
                <div class="page-error" role="alert">@_pageError</div>
            }

            @if (_checkInError is not null)
            {
                <div class="check-in-error" role="alert">@_checkInError</div>
            }

            @if (_checkInResult is not null)
            {
                <div class="check-in-result @_checkInOutcomeClass" role="status">@_checkInResult</div>
            }

            @if (_operationError is not null)
            {
                <div class="operation-error" role="alert">@_operationError</div>
            }

            @if (_operationResult is not null)
            {
                <div class="operation-result" role="status">@_operationResult</div>
            }

            @switch (CurrentPagePhase)
            {
                case AttendancePagePhase.NotOpen:
                    <div class="attendance-state-banner phase-not-open" role="status">
                        <strong>Check-in not open</strong>
                        <span>Check-in opens at @FormatLocalTime(_snapshot.CheckInOpensAtUtc).</span>
                    </div>
                    break;
                case AttendancePagePhase.AbsenceReview:
                    <div class="attendance-state-banner phase-absence-review" role="status">
                        <strong>Absence review required</strong>
                        <span>Confirm every pending absence before ending the session.</span>
                    </div>
                    break;
                case AttendancePagePhase.Finalized:
                    <div id="attendance-finalized-status"
                         class="attendance-state-banner finalized-banner phase-finalized"
                         role="status"
                         tabindex="-1">Attendance finalized — read-only</div>
                    break;
                default:
                    <div class="attendance-state-banner phase-in-progress" role="status">
                        <strong>Attendance in progress</strong>
                        <span>The workstation determines Present or Late from the receipt time.</span>
                    </div>
                    break;
            }

            <section class="attendance-summary" aria-label="Attendance totals">
                <dl class="attendance-summary-card status-total">
                    <dt>Total</dt>
                    <dd>@_snapshot.Definition.Students.Count</dd>
                </dl>
                <dl class="attendance-summary-card status-present">
                    <dt>Present</dt>
                    <dd>@_snapshot.PresentCount</dd>
                </dl>
                <dl class="attendance-summary-card status-late">
                    <dt>Late</dt>
                    <dd>@_snapshot.LateCount</dd>
                </dl>
                <dl class="attendance-summary-card status-absent">
                    <dt>Absent</dt>
                    <dd>@_snapshot.AbsentCount</dd>
                </dl>
                <dl class="attendance-summary-card status-pending">
                    <dt>Pending</dt>
                    <dd>@_snapshot.PendingCount</dd>
                </dl>
                <dl class="attendance-summary-card status-unmarked">
                    <dt>Unmarked</dt>
                    <dd>@_snapshot.UnmarkedCount</dd>
                </dl>
            </section>

            @if (!_snapshot.IsFinalized && DisplayedPendingStudents.Count > 0)
            {
                <section class="absence-review" aria-labelledby="absence-review-title">
                    <div>
                        <p class="review-kicker">Absence review</p>
                        <h2 id="absence-review-title">
                            <span class="pending-count">@DisplayedPendingStudents.Count</span>
                            pending absence@(DisplayedPendingStudents.Count == 1 ? string.Empty : "s") displayed
                        </h2>
                        <p>Confirm each student who did not attend before ending the session.</p>
                    </div>
                    <button class="confirm-all-absent"
                            type="button"
                            disabled="@_isSubmitting"
                            @onclick="OpenBulkAbsenceDialog">
                        Confirm all displayed as Absent
                    </button>
                </section>
            }

            <section class="roster-panel @(_snapshot.IsFinalized ? "read-only" : null)"
                     aria-labelledby="roster-title">
                <div class="roster-heading">
                    <div>
                        <h2 id="roster-title">Student roster</h2>
                        <p>@FilteredStudents.Count student@(FilteredStudents.Count == 1 ? string.Empty : "s") shown</p>
                    </div>
                    <div class="roster-controls">
                        <div class="search-field">
                            <label for="student-search">Search by student number or name</label>
                            <input id="student-search"
                                   type="search"
                                   value="@_searchText"
                                   @oninput="SearchChanged"
                                   placeholder="Search roster" />
                        </div>
                        <div class="status-filter-field">
                            <label for="attendance-status-filter">Attendance status</label>
                            <select id="attendance-status-filter"
                                    value="@(_statusFilter?.ToString() ?? string.Empty)"
                                    @onchange="StatusFilterChanged">
                                <option value="">All students</option>
                                <option value="@nameof(AttendanceStatus.Unmarked)">Unmarked</option>
                                <option value="@nameof(AttendanceStatus.Present)">Present</option>
                                <option value="@nameof(AttendanceStatus.Late)">Late</option>
                                <option value="@nameof(AttendanceStatus.PendingAbsence)">Pending</option>
                                <option value="@nameof(AttendanceStatus.Absent)">Absent</option>
                            </select>
                        </div>
                    </div>
                </div>

                @if (FilteredStudents.Count == 0)
                {
                    <p class="empty-roster">No students match the current search and status filter.</p>
                }
                else
                {
                    <table class="roster-table">
                        <caption>Attendance roster for @_snapshot.Definition.Title</caption>
                        <thead>
                            <tr>
                                <th scope="col">Student</th>
                                <th scope="col">Seat</th>
                                <th scope="col">Attendance</th>
                                <th scope="col">Check-in</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in FilteredStudents)
                            {
                                var entry = EntryFor(student.Id);
                                <tr data-student-id="@student.Id">
                                    <th class="student-cell" scope="row" data-label="Student">
                                        <span class="student-identity">
                                            <strong>@student.FullName</strong>
                                            <span>@student.StudentNumber</span>
                                        </span>
                                    </th>
                                    <td class="seat-cell" data-label="Seat">@student.SeatLabel</td>
                                    <td class="status-cell" data-label="Attendance">
                                        <span class="student-status @StatusClass(entry.Status)">@StatusText(entry.Status)</span>
                                    </td>
                                    <td class="method-cell" data-label="Check-in">
                                        @if (entry.CheckInMethod.HasValue)
                                        {
                                            <span class="check-in-method">@MethodText(entry.CheckInMethod)</span>
                                            @if (entry.ReceivedAtUtc.HasValue)
                                            {
                                                <time datetime="@entry.ReceivedAtUtc.Value.ToString("O")">
                                                    @FormatLocalTime(entry.ReceivedAtUtc.Value)
                                                </time>
                                            }
                                        }
                                        else
                                        {
                                            <span class="check-in-method">—</span>
                                        }
                                    </td>
                                    <td class="row-actions" data-label="Actions">
                                        @if (!_snapshot.IsFinalized && entry.Status == AttendanceStatus.Unmarked)
                                        {
                                            <button class="check-in-attendance"
                                                    type="button"
                                                    disabled="@(!CanOpenCheckIn(entry) || _isSubmitting)"
                                                    aria-label="Check in @student.FullName, student number @student.StudentNumber, seat @student.SeatLabel"
                                                    @onclick="() => OpenManualCheckIn(student)">
                                                Check in
                                            </button>
                                        }
                                        @if (!_snapshot.IsFinalized && entry.Status == AttendanceStatus.PendingAbsence)
                                        {
                                            <button class="confirm-absent"
                                                    type="button"
                                                    disabled="@_isSubmitting"
                                                    @onclick="() => ConfirmAbsentAsync(student.Id)">
                                                Confirm absent
                                            </button>
                                        }
                                        @if (!_snapshot.IsFinalized && entry.Status is AttendanceStatus.Present or AttendanceStatus.Late or AttendanceStatus.Absent)
                                        {
                                            <button class="correct-attendance"
                                                    type="button"
                                                    disabled="@_isSubmitting"
                                                    @onclick="() => OpenCorrection(student)">
                                                Correct
                                            </button>
                                        }
                                        @if (_snapshot.IsFinalized)
                                        {
                                            <span class="read-only-label">Read-only</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>

            @if (_snapshot.AuditEntries.Count > 0)
            {
                <details class="attendance-history">
                    <summary>Attendance history (@_snapshot.AuditEntries.Count)</summary>
                    <div class="audit-history-content">
                        <p>Newest changes appear first.</p>
                        <ol>
                            @foreach (var audit in OrderedAuditEntries)
                            {
                                <li class="audit-entry">
                                    <div>
                                        <strong>@StudentName(audit.StudentId)</strong>
                                        <span>@StatusText(audit.PriorStatus) to @StatusText(audit.NewStatus)</span>
                                    </div>
                                    <p>@audit.Reason</p>
                                    <small>@ProctorName(audit.ProctorId) · @FormatLocalTimestamp(audit.OccurredAtUtc)</small>
                                </li>
                            }
                        </ol>
                    </div>
                </details>
            }
        }
    </div>
}

@if (_selectedStudent is not null)
{
    <div class="dialog-backdrop">
        <section class="attendance-dialog manual-dialog"
                 @ref="_dialogElement"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="manual-dialog-title"
                 @onkeydown="HandleDialogKeyDownAsync">
            <header class="dialog-heading">
                <div>
                    <p>Manual attendance</p>
                    <h2 id="manual-dialog-title">Confirm student identity</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="Cancel manual check-in" @onclick="CancelManualCheckInAsync">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </header>

            <div class="dialog-student">
                <img src="@_selectedStudent.ReferencePhotoPath"
                     alt="Reference photo of @_selectedStudent.FullName"
                     width="88"
                     height="88" />
                <div>
                    <strong>@_selectedStudent.FullName</strong>
                    <span>@_selectedStudent.StudentNumber</span>
                </div>
            </div>

            <div class="reason-field">
                <label for="manual-reason">Reason for manual check-in <span aria-hidden="true">*</span></label>
                <textarea id="manual-reason"
                          autofocus
                          required
                          aria-required="true"
                          rows="3"
                          value="@_manualReason"
                          aria-describedby="manual-reason-help"
                          aria-errormessage="@(string.IsNullOrWhiteSpace(_manualReason) ? "manual-reason-error" : null)"
                          aria-invalid="@string.IsNullOrWhiteSpace(_manualReason).ToString().ToLowerInvariant()"
                          @oninput="ReasonChanged"
                          @onchange="ReasonChanged"></textarea>
                <p id="manual-reason-help" class="field-help">Record why the scanner or printed permit could not be used.</p>
                @if (string.IsNullOrWhiteSpace(_manualReason))
                {
                    <p id="manual-reason-error" class="field-error">Enter a reason for manual check-in.</p>
                }
            </div>

            <label class="identity-confirmation" for="identity-confirmed">
                <input id="identity-confirmed"
                       type="checkbox"
                       checked="@_identityConfirmed"
                       @onchange="IdentityConfirmationChanged" />
                <span>I compared the student with the reference photo and confirmed their identity.</span>
            </label>

            <footer class="dialog-actions">
                <button class="cancel-check-in" type="button" @onclick="CancelManualCheckInAsync">Cancel</button>
                <button class="confirm-check-in"
                        type="button"
                        disabled="@(!CanConfirm)"
                        @onclick="ConfirmManualCheckInAsync">
                    @(_isSubmitting ? "Saving..." : "Confirm check-in")
                </button>
            </footer>
        </section>
    </div>
}

@if (_correctionStudent is not null)
{
    <div class="dialog-backdrop">
        <section class="attendance-dialog correction-dialog"
                 @ref="_dialogElement"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="correction-dialog-title"
                 @onkeydown="HandleDialogKeyDownAsync">
            <header class="dialog-heading">
                <div>
                    <p>Audited correction</p>
                    <h2 id="correction-dialog-title">Correct attendance</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="Cancel attendance correction" @onclick="CancelCorrectionAsync">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </header>

            <div class="dialog-student compact-student">
                <img src="@_correctionStudent.ReferencePhotoPath"
                     alt="Reference photo of @_correctionStudent.FullName"
                     width="64"
                     height="64" />
                <div>
                    <strong>@_correctionStudent.FullName</strong>
                    <span>@_correctionStudent.StudentNumber · Current status: @StatusText(EntryFor(_correctionStudent.Id).Status)</span>
                </div>
            </div>

            @if (_correctionError is not null)
            {
                <div class="correction-error" role="alert">@_correctionError</div>
            }

            <div class="correction-status-field">
                <label for="correction-status">Replacement status</label>
                <select id="correction-status"
                        autofocus
                        value="@_correctionStatus"
                        @onchange="CorrectionStatusChanged">
                    <option value="@AttendanceStatus.Present">Present</option>
                    <option value="@AttendanceStatus.Late">Late</option>
                    <option value="@AttendanceStatus.Absent">Absent</option>
                </select>
            </div>

            <div class="reason-field">
                <label for="correction-reason">Reason for correction <span aria-hidden="true">*</span></label>
                <textarea id="correction-reason"
                          required
                          aria-required="true"
                          rows="3"
                          value="@_correctionReason"
                          aria-errormessage="@(string.IsNullOrWhiteSpace(_correctionReason) ? "correction-reason-error" : null)"
                          aria-invalid="@string.IsNullOrWhiteSpace(_correctionReason).ToString().ToLowerInvariant()"
                          @oninput="CorrectionReasonChanged"
                          @onchange="CorrectionReasonChanged"></textarea>
                @if (string.IsNullOrWhiteSpace(_correctionReason))
                {
                    <p id="correction-reason-error" class="field-error">Enter a reason for this correction.</p>
                }
            </div>

            <footer class="dialog-actions">
                <button class="cancel-check-in cancel-correction" type="button" @onclick="CancelCorrectionAsync">Cancel</button>
                <button class="confirm-check-in save-correction"
                        type="button"
                        disabled="@(!CanSaveCorrection)"
                        @onclick="SaveCorrectionAsync">
                    @(_isSubmitting ? "Saving..." : "Save correction")
                </button>
            </footer>
        </section>
    </div>
}

@if (_showBulkAbsenceDialog && _bulkAbsenceStudentIds.Count > 0)
{
    <div class="dialog-backdrop">
        <section class="attendance-dialog bulk-absence-dialog"
                 @ref="_dialogElement"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="bulk-absence-dialog-title"
                 @onkeydown="HandleDialogKeyDownAsync">
            <header class="dialog-heading">
                <div>
                    <p>Absence review</p>
                    <h2 id="bulk-absence-dialog-title">
                        Confirm @_bulkAbsenceStudentIds.Count displayed student@(_bulkAbsenceStudentIds.Count == 1 ? string.Empty : "s") as Absent?
                    </h2>
                </div>
                <button class="dialog-close"
                        type="button"
                        aria-label="Cancel bulk absence confirmation"
                        @onclick="CancelBulkAbsenceAsync">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </header>

            <p class="bulk-absence-warning">
                Only Pending students currently included by your search and status filter will change.
            </p>

            @if (_operationError is not null)
            {
                <div class="operation-error" role="alert">@_operationError</div>
            }

            <footer class="dialog-actions">
                <button class="cancel-check-in cancel-bulk-absence"
                        type="button"
                        disabled="@_isSubmitting"
                        @onclick="CancelBulkAbsenceAsync">
                    Cancel
                </button>
                <button class="confirm-check-in confirm-bulk-absence"
                        type="button"
                        autofocus
                        disabled="@_isSubmitting"
                        @onclick="ConfirmDisplayedAbsencesAsync">
                    @(_isSubmitting ? "Confirming..." : "Confirm as Absent")
                </button>
            </footer>
        </section>
    </div>
}

@if (_showFinalizationDialog && _snapshot is not null && !_snapshot.IsFinalized)
{
    <div class="dialog-backdrop">
        <section class="attendance-dialog finalization-dialog"
                 @ref="_dialogElement"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="finalization-dialog-title"
                 @onkeydown="HandleDialogKeyDownAsync">
            <header class="dialog-heading">
                <div>
                    <p>Final attendance record</p>
                    <h2 id="finalization-dialog-title">End this session?</h2>
                </div>
                <button class="dialog-close" type="button" aria-label="Cancel session finalization" @onclick="CancelFinalizationAsync">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </header>

            <p class="finalization-warning">Finalization makes every attendance entry read-only. Review these totals before continuing.</p>

            <dl class="finalization-totals" aria-label="Final attendance totals">
                <div class="finalization-total">
                    <dt>Present</dt>
                    <dd>@_snapshot.PresentCount</dd>
                </div>
                <div class="finalization-total">
                    <dt>Late</dt>
                    <dd>@_snapshot.LateCount</dd>
                </div>
                <div class="finalization-total">
                    <dt>Absent</dt>
                    <dd>@_snapshot.AbsentCount</dd>
                </div>
            </dl>

            @if (_finalizationError is not null)
            {
                <div class="finalization-error" role="alert">@_finalizationError</div>
            }

            <label class="identity-confirmation finalization-confirmation" for="finalization-confirmed">
                <input id="finalization-confirmed"
                       type="checkbox"
                       autofocus
                       disabled="@_snapshot.IsFinalized"
                       checked="@_finalizationConfirmed"
                       @onchange="FinalizationConfirmationChanged" />
                <span>I reviewed the Present, Late, and Absent totals and confirm this attendance record is complete.</span>
            </label>

            <footer class="dialog-actions">
                <button class="cancel-check-in cancel-finalization" type="button" @onclick="CancelFinalizationAsync">Cancel</button>
                <button class="confirm-check-in finalize-attendance"
                        type="button"
                        disabled="@(!_finalizationConfirmed || _isSubmitting || _snapshot.IsFinalized)"
                        @onclick="FinalizeAttendanceAsync">
                    @(_isSubmitting ? "Finalizing..." : "Finalize attendance")
                </button>
            </footer>
        </section>
    </div>
}

@code {
    private static readonly TimeSpan PhilippineOffset = TimeSpan.FromHours(8);

    private enum AttendancePagePhase
    {
        NotOpen,
        InProgress,
        AbsenceReview,
        Finalized
    }

    private readonly CancellationTokenSource _timerCancellation = new();
    private PeriodicTimer? _cutoffTimer;
    private AttendanceSessionSnapshot? _snapshot;
    private IReadOnlyList<Guid> _bulkAbsenceStudentIds = [];
    private AssignedStudent? _selectedStudent;
    private AssignedStudent? _correctionStudent;
    private ElementReference _dialogElement;
    private Task? _timerTask;
    private string _searchText = string.Empty;
    private string _manualReason = string.Empty;
    private string _correctionReason = string.Empty;
    private string? _pageError;
    private string? _checkInError;
    private string? _checkInResult;
    private string? _checkInOutcomeClass;
    private string? _operationError;
    private string? _operationResult;
    private string? _correctionError;
    private string? _finalizationError;
    private AttendanceStatus? _statusFilter;
    private AttendanceStatus _correctionStatus = AttendanceStatus.Absent;
    private bool _identityConfirmed;
    private bool _finalizationConfirmed;
    private bool _isLoading;
    private bool _isSubmitting;
    private bool _openDialog;
    private bool _showBulkAbsenceDialog;
    private bool _showFinalizationDialog;
    private bool _focusFinalizedStatus;
    private bool _disposed;

    [Parameter]
    public Guid SessionId { get; set; }

    private bool CanConfirm =>
        !_isSubmitting &&
        _identityConfirmed &&
        !string.IsNullOrWhiteSpace(_manualReason);

    private bool CanSaveCorrection =>
        !_isSubmitting &&
        !string.IsNullOrWhiteSpace(_correctionReason);

    private AttendancePagePhase CurrentPagePhase
    {
        get
        {
            if (_snapshot?.IsFinalized == true)
            {
                return AttendancePagePhase.Finalized;
            }

            var now = TimeProvider.GetUtcNow();
            if (_snapshot is null || now < _snapshot.CheckInOpensAtUtc)
            {
                return AttendancePagePhase.NotOpen;
            }

            if (now >= _snapshot.CutoffAtUtc &&
                (_snapshot.PendingCount > 0 || _snapshot.UnmarkedCount > 0))
            {
                return AttendancePagePhase.AbsenceReview;
            }

            return AttendancePagePhase.InProgress;
        }
    }

    private IReadOnlyList<AssignedStudent> FilteredStudents
    {
        get
        {
            if (_snapshot is null)
            {
                return [];
            }

            var search = _searchText.Trim();
            return _snapshot.Definition.Students
                .Where(student =>
                    string.IsNullOrWhiteSpace(search) ||
                    student.FullName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    student.StudentNumber.Contains(search, StringComparison.OrdinalIgnoreCase))
                .Where(student =>
                    !_statusFilter.HasValue ||
                    EntryFor(student.Id).Status == _statusFilter.Value)
                .ToArray();
        }
    }

    private IReadOnlyList<AssignedStudent> DisplayedPendingStudents =>
        FilteredStudents
            .Where(student => EntryFor(student.Id).Status == AttendanceStatus.PendingAbsence)
            .ToArray();

    private IReadOnlyList<AttendanceAuditEntry> OrderedAuditEntries =>
        _snapshot?.AuditEntries
            .Select((entry, index) => (Entry: entry, Index: index))
            .OrderByDescending(item => item.Entry.OccurredAtUtc)
            .ThenByDescending(item => item.Index)
            .Select(item => item.Entry)
            .ToArray()
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        if (ProctorSession.Proctor is not { } proctor)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _isLoading = true;
        try
        {
            var cancellationToken = _timerCancellation.Token;
            _snapshot = await AttendanceService.LoadAsync(SessionId, proctor.Id, cancellationToken);
            if (!_snapshot.IsFinalized)
            {
                _snapshot = await AttendanceService.ApplyCutoffAsync(SessionId, proctor.Id, cancellationToken);
            }
            _cutoffTimer = new PeriodicTimer(TimeSpan.FromMinutes(1), TimeProvider);
            _timerTask = RunCutoffTimerAsync(_timerCancellation.Token);
        }
        catch (InvalidOperationException exception)
            when (exception.Message == "The attendance session is not assigned to this proctor.")
        {
            _pageError = "This attendance session is not assigned to your account.";
        }
        catch
        {
            _pageError = "The attendance roster could not be loaded. Return to assigned sessions and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusFinalizedStatus)
        {
            _focusFinalizedStatus = false;
            await TryCloseDialogToAsync("attendance-finalized-status");
        }

        if (!_openDialog)
        {
            return;
        }

        _openDialog = false;
        try
        {
            await JS.InvokeVoidAsync("philslaAttendanceDialog.open", _dialogElement);
        }
        catch (Exception exception) when (IsFocusInteropFailure(exception))
        {
        }
    }

    private async Task RunCutoffTimerAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (_cutoffTimer is not null &&
                   await _cutoffTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await ApplyCutoffAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task ApplyCutoffAsync(CancellationToken cancellationToken)
    {
        if (ProctorSession.Proctor is not { } proctor || _snapshot?.IsFinalized == true)
        {
            return;
        }

        try
        {
            _snapshot = await AttendanceService.ApplyCutoffAsync(
                SessionId,
                proctor.Id,
                cancellationToken);
            _pageError = null;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch
        {
            _pageError = "Attendance could not be refreshed. The current roster remains available.";
        }
    }

    private AttendanceEntry EntryFor(Guid studentId) =>
        _snapshot!.Entries.Single(entry => entry.StudentId == studentId);

    private void SearchChanged(ChangeEventArgs args) =>
        _searchText = args.Value?.ToString() ?? string.Empty;

    private void StatusFilterChanged(ChangeEventArgs args)
    {
        _statusFilter = Enum.TryParse<AttendanceStatus>(args.Value?.ToString(), out var status)
            ? status
            : null;
    }

    private bool CanOpenCheckIn(AttendanceEntry entry)
    {
        if (_snapshot is null ||
            _snapshot.IsFinalized ||
            entry.Status != AttendanceStatus.Unmarked)
        {
            return false;
        }

        var now = TimeProvider.GetUtcNow();
        return now >= _snapshot.CheckInOpensAtUtc && now < _snapshot.CutoffAtUtc;
    }

    private void OpenManualCheckIn(AssignedStudent student)
    {
        if (_snapshot is null || !CanOpenCheckIn(EntryFor(student.Id)))
        {
            return;
        }

        _selectedStudent = student;
        _manualReason = string.Empty;
        _identityConfirmed = false;
        _checkInError = null;
        _checkInResult = null;
        _checkInOutcomeClass = null;
        _openDialog = true;
    }

    private async Task ConfirmAbsentAsync(Guid studentId)
    {
        if (_snapshot?.IsFinalized != false ||
            ProctorSession.Proctor is not { } proctor ||
            _isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _operationError = null;
        _operationResult = null;
        try
        {
            _snapshot = await AttendanceService.ConfirmAbsentAsync(
                SessionId,
                studentId,
                proctor.Id);
            _operationResult = $"{StudentName(studentId)} confirmed Absent.";
        }
        catch
        {
            _operationError = "Absence could not be confirmed. Try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenBulkAbsenceDialog()
    {
        if (_snapshot?.IsFinalized != false || _isSubmitting)
        {
            return;
        }

        _bulkAbsenceStudentIds = DisplayedPendingStudents
            .Select(student => student.Id)
            .ToArray();
        if (_bulkAbsenceStudentIds.Count == 0)
        {
            return;
        }

        _showBulkAbsenceDialog = true;
        _operationError = null;
        _operationResult = null;
        _openDialog = true;
    }

    private async Task ConfirmDisplayedAbsencesAsync()
    {
        if (_snapshot?.IsFinalized != false ||
            ProctorSession.Proctor is not { } proctor ||
            _isSubmitting ||
            !_showBulkAbsenceDialog)
        {
            return;
        }

        var pendingStudentIds = _bulkAbsenceStudentIds.ToArray();
        _isSubmitting = true;
        _operationError = null;
        _operationResult = null;
        var confirmedCount = 0;
        try
        {
            foreach (var studentId in pendingStudentIds)
            {
                _snapshot = await AttendanceService.ConfirmAbsentAsync(
                    SessionId,
                    studentId,
                    proctor.Id);
                confirmedCount++;
            }

            _operationResult = $"{confirmedCount} absence{(confirmedCount == 1 ? string.Empty : "s")} confirmed.";
            ClearDialogState();
            await TryCloseDialogAsync();
        }
        catch
        {
            _bulkAbsenceStudentIds = pendingStudentIds
                .Where(studentId => EntryFor(studentId).Status == AttendanceStatus.PendingAbsence)
                .ToArray();
            _operationError =
                $"Bulk confirmation stopped after {confirmedCount} durable confirmation{(confirmedCount == 1 ? string.Empty : "s")}. Try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void OpenCorrection(AssignedStudent student)
    {
        if (_snapshot?.IsFinalized != false)
        {
            return;
        }

        var currentStatus = EntryFor(student.Id).Status;
        if (currentStatus is AttendanceStatus.Unmarked or AttendanceStatus.PendingAbsence)
        {
            return;
        }

        _correctionStudent = student;
        _correctionStatus = currentStatus;
        _correctionReason = string.Empty;
        _correctionError = null;
        _operationError = null;
        _operationResult = null;
        _openDialog = true;
    }

    private void CorrectionStatusChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<AttendanceStatus>(args.Value?.ToString(), out var status) &&
            status is AttendanceStatus.Present or AttendanceStatus.Late or AttendanceStatus.Absent)
        {
            _correctionStatus = status;
        }
    }

    private void CorrectionReasonChanged(ChangeEventArgs args) =>
        _correctionReason = args.Value?.ToString() ?? string.Empty;

    private async Task SaveCorrectionAsync()
    {
        if (!CanSaveCorrection ||
            _correctionStudent is null ||
            ProctorSession.Proctor is not { } proctor ||
            _snapshot?.IsFinalized != false)
        {
            return;
        }

        _isSubmitting = true;
        _correctionError = null;
        AttendanceSessionSnapshot? correctedSnapshot = null;
        try
        {
            var studentName = _correctionStudent.FullName;
            correctedSnapshot = await AttendanceService.CorrectAsync(
                SessionId,
                _correctionStudent.Id,
                _correctionStatus,
                _correctionReason,
                proctor.Id);
            _snapshot = correctedSnapshot;
            _operationResult = $"Attendance corrected for {studentName}.";
        }
        catch (AttendancePolicyException exception)
        {
            _correctionError = exception.Message;
        }
        catch
        {
            _correctionError = "The attendance correction could not be saved. Try again.";
        }
        finally
        {
            _isSubmitting = false;
        }

        if (correctedSnapshot is not null)
        {
            ClearDialogState();
            await TryCloseDialogAsync();
        }
    }

    private void OpenFinalizationDialog()
    {
        if (_snapshot is null || _snapshot.IsFinalized || _isSubmitting)
        {
            return;
        }

        _operationError = null;
        _operationResult = null;
        if (_snapshot.PendingCount > 0 || _snapshot.UnmarkedCount > 0)
        {
            _operationError = "Confirm all pending absences before ending the session.";
            return;
        }

        _showFinalizationDialog = true;
        _finalizationConfirmed = false;
        _finalizationError = null;
        _openDialog = true;
    }

    private void FinalizationConfirmationChanged(ChangeEventArgs args) =>
        _finalizationConfirmed = args.Value is true ||
        bool.TryParse(args.Value?.ToString(), out var confirmed) && confirmed;

    private async Task FinalizeAttendanceAsync()
    {
        if (!_finalizationConfirmed ||
            !_showFinalizationDialog ||
            ProctorSession.Proctor is not { } proctor ||
            _isSubmitting ||
            _snapshot?.IsFinalized != false)
        {
            return;
        }

        _isSubmitting = true;
        _finalizationError = null;
        try
        {
            _snapshot = await AttendanceService.FinalizeAsync(SessionId, proctor.Id);
            ClearDialogState();
            _focusFinalizedStatus = true;
        }
        catch (InvalidOperationException exception)
        {
            try
            {
                _snapshot = await AttendanceService.LoadAsync(SessionId, proctor.Id);
            }
            catch
            {
                _finalizationError = "Attendance could not be finalized. Review the roster and try again.";
                return;
            }

            if (_snapshot.IsFinalized)
            {
                ClearDialogState();
                _focusFinalizedStatus = true;
                return;
            }

            var unresolvedNames = _snapshot.Definition.Students
                .Where(student => EntryFor(student.Id).Status is AttendanceStatus.Unmarked or AttendanceStatus.PendingAbsence)
                .Select(student => student.FullName)
                .ToArray();
            if (exception is AttendancePolicyException policyException)
            {
                _finalizationError = unresolvedNames.Length == 0
                    ? policyException.Message
                    : $"{policyException.Message} Unresolved: {string.Join(", ", unresolvedNames)}.";
            }
            else
            {
                _finalizationError = "Attendance could not be finalized. Review the roster and try again.";
            }
        }
        catch
        {
            _finalizationError = "Attendance could not be finalized. Review the roster and try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ReasonChanged(ChangeEventArgs args) =>
        _manualReason = args.Value?.ToString() ?? string.Empty;

    private void IdentityConfirmationChanged(ChangeEventArgs args) =>
        _identityConfirmed = args.Value is true ||
        bool.TryParse(args.Value?.ToString(), out var confirmed) && confirmed;

    private async Task ConfirmManualCheckInAsync()
    {
        if (!CanConfirm ||
            _selectedStudent is null ||
            ProctorSession.Proctor is not { } proctor ||
            _snapshot is null)
        {
            return;
        }

        _isSubmitting = true;
        _checkInError = null;
        _checkInResult = null;
        try
        {
            var result = await AttendanceService.CheckInWithResultAsync(
                SessionId,
                _selectedStudent.Id,
                AttendanceCheckInMethod.Manual,
                proctor.Id,
                credentialId: null,
                manualReason: _manualReason);
            _snapshot = result.Snapshot;
            var updatedEntry = EntryFor(_selectedStudent.Id);
            if (!result.WasCreated)
            {
                _checkInResult = "Already checked in";
                _checkInOutcomeClass = "outcome-info";
            }
            else
            {
                (_checkInResult, _checkInOutcomeClass) = updatedEntry.Status switch
                {
                    AttendanceStatus.Present => ("Checked in — Present", "outcome-success"),
                    AttendanceStatus.Late => ("Checked in — Late", "outcome-warning"),
                    _ => throw new InvalidOperationException("The attendance service returned an unsupported check-in status.")
                };
            }

            await CloseDialogAsync();
        }
        catch (AttendancePolicyException exception)
        {
            _checkInResult = exception.Message.TrimEnd('.');
            _checkInOutcomeClass = exception.Message == "Check-in closed."
                ? "outcome-error"
                : "outcome-warning";
            await CloseDialogAsync();
        }
        catch
        {
            _checkInError = "Manual check-in could not be saved. Try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task HandleDialogKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !_isSubmitting)
        {
            await CloseDialogAsync();
        }
    }

    private async Task CancelManualCheckInAsync()
    {
        if (!_isSubmitting)
        {
            await CloseDialogAsync();
        }
    }

    private async Task CancelCorrectionAsync()
    {
        if (!_isSubmitting)
        {
            await CloseDialogAsync();
        }
    }

    private async Task CancelBulkAbsenceAsync()
    {
        if (!_isSubmitting)
        {
            await CloseDialogAsync();
        }
    }

    private async Task CancelFinalizationAsync()
    {
        if (!_isSubmitting)
        {
            await CloseDialogAsync();
        }
    }

    private async Task CloseDialogAsync()
    {
        ClearDialogState();
        await TryCloseDialogAsync();
    }

    private void ClearDialogState()
    {
        _selectedStudent = null;
        _correctionStudent = null;
        _bulkAbsenceStudentIds = [];
        _showBulkAbsenceDialog = false;
        _showFinalizationDialog = false;
        _manualReason = string.Empty;
        _correctionReason = string.Empty;
        _identityConfirmed = false;
        _finalizationConfirmed = false;
        _correctionError = null;
        _finalizationError = null;
        _openDialog = false;
    }

    private async Task TryCloseDialogAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("philslaAttendanceDialog.close");
        }
        catch (Exception exception) when (IsFocusInteropFailure(exception))
        {
        }
    }

    private async Task TryCloseDialogToAsync(string targetId)
    {
        try
        {
            await JS.InvokeVoidAsync("philslaAttendanceDialog.closeTo", targetId);
        }
        catch (Exception exception) when (IsFocusInteropFailure(exception))
        {
        }
    }

    private static bool IsFocusInteropFailure(Exception exception) =>
        exception is JSException or JSDisconnectedException;

    private static string FormatSchedule(AttendanceSessionDefinition session)
    {
        var startsAt = session.StartsAtUtc.ToOffset(PhilippineOffset);
        var endsAt = session.EndsAtUtc.ToOffset(PhilippineOffset);
        return $"{startsAt:MMM d, yyyy · hh:mm tt} – {endsAt:hh:mm tt}";
    }

    private static string FormatLocalTime(DateTimeOffset value) =>
        value.ToOffset(PhilippineOffset).ToString("hh:mm tt");

    private static string FormatLocalTimestamp(DateTimeOffset value) =>
        value.ToOffset(PhilippineOffset).ToString("MMM d, yyyy · hh:mm tt");

    private string StudentName(Guid studentId) =>
        _snapshot?.Definition.Students.SingleOrDefault(student => student.Id == studentId)?.FullName
        ?? studentId.ToString();

    private string ProctorName(Guid proctorId) =>
        ProctorSession.Proctor is { } proctor && proctor.Id == proctorId
            ? $"{proctor.FirstName} {proctor.LastName}"
            : proctorId.ToString();

    private static string StatusText(AttendanceStatus status) => status switch
    {
        AttendanceStatus.PendingAbsence => "Pending",
        _ => status.ToString()
    };

    private static string StatusClass(AttendanceStatus status) =>
        $"status-{status.ToString().ToLowerInvariant()}";

    private static string MethodText(AttendanceCheckInMethod? method) => method switch
    {
        AttendanceCheckInMethod.Qr => "QR",
        AttendanceCheckInMethod.Manual => "Manual",
        _ => "Not checked in"
    };

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        await _timerCancellation.CancelAsync();
        _cutoffTimer?.Dispose();
        if (_timerTask is not null)
        {
            await _timerTask;
        }

        _timerCancellation.Dispose();
    }
}
