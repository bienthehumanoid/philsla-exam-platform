@page "/home"
@inject ProctorSessionState ProctorSession
@inject NavigationManager Navigation

@if (ProctorSession.Proctor is not null)
{
    <h1>Proctor dashboard</h1>

    <p>Signed in as @ProctorSession.Proctor.FirstName @ProctorSession.Proctor.LastName.</p>
}

@code {
    protected override void OnInitialized()
    {
        if (!ProctorSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
        }
    }
}
