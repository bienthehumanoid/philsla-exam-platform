@page "/home"
@inject ProctorSessionState ProctorSession
@inject NavigationManager Navigation
@inject AttendanceService AttendanceService

<PageTitle>Exam Schedule | PhilSLA Proctor Workstation</PageTitle>

@if (ProctorSession.IsAuthenticated)
{
    <div class="schedule-page">
        <header class="page-heading">
            <div>
                <h1>Exam Schedule</h1>
                <p>Review assigned exam sessions and sync secure packages for deployment.</p>
            </div>
            <button class="secondary-button" type="button" disabled title="Schedule state controls are not available yet" aria-label="Reset All States (not available yet)">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                    <path d="M3 3v5h5" />
                </svg>
                Reset All States
            </button>
        </header>

        <section class="readiness-card" aria-labelledby="readiness-title">
            <div class="readiness-heading">
                <span class="readiness-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 3l7 3v5c0 4.6-2.9 8-7 10-4.1-2-7-5.4-7-10V6l7-3Z" />
                        <path d="m9.5 12 1.7 1.7 3.6-3.7" />
                    </svg>
                </span>
                <div class="readiness-copy">
                    <div class="title-line">
                        <h2 id="readiness-title">Workstation &amp; Network Readiness</h2>
                        <span class="verified-badge">Verified ready</span>
                    </div>
                    <p>Verify internet connection speed, cloud API handshake, and workstation hardware diagnostics before exam launch.</p>
                </div>
                <button class="primary-button" type="button" disabled title="System diagnostics are not available yet" aria-label="Check System (not available yet)">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <path d="m13 2-9 12h7l-1 8 9-12h-7l1-8Z" />
                    </svg>
                    Check System
                </button>
            </div>

            <div class="diagnostic-status">
                <span class="diagnostic-message">
                    <svg aria-hidden="true" viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="9" />
                        <path d="m8 12 2.5 2.5L16 9" />
                    </svg>
                    System Diagnostics Verified (100% Passed)
                </span>
                <dl class="diagnostic-metrics">
                    <div><dt>Latency:</dt><dd>8ms</dd></div>
                    <div><dt>Bandwidth:</dt><dd>142 Mbps</dd></div>
                    <div><dt>Subnet:</dt><dd>LAN Active</dd></div>
                </dl>
            </div>
        </section>

        <section class="sessions-section" aria-labelledby="sessions-title">
            <div class="section-heading">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="16" rx="2" />
                    <path d="M8 3v4M16 3v4M3 10h18" />
                </svg>
                <h2 id="sessions-title">Assigned Examination Sessions</h2>
                <span>@(_isLoading ? "Loading" : $"{_sessions.Count} sessions")</span>
            </div>

            @if (_isLoading)
            {
                <p class="sessions-loading" role="status">Loading assigned sessions...</p>
            }
            else if (_loadError is not null)
            {
                <div class="sessions-error" role="alert">
                    <p>@_loadError</p>
                    <button class="retry-button" type="button" @onclick="LoadSessionsAsync">Retry</button>
                </div>
            }
            else
            {
                <div class="session-list">
                    @foreach (var snapshot in _sessions)
                    {
                        var session = snapshot.Definition;
                        <article class="session-card">
                            <header class="session-header">
                                <div>
                                    <h3>@session.Title</h3>
                                    <p>@FormatSchedule(session) · @FormatDate(session.StartsAtUtc) · @session.Room</p>
                                </div>
                                <span class="sync-badge">Attendance stored locally</span>
                            </header>

                            <div class="exam-set-row">
                                <p>Assigned exam set : <strong>@session.ExamSet</strong></p>
                            </div>

                            <footer class="session-footer">
                                <dl class="attendance-summary" aria-label="Attendance summary">
                                    <div><dt>@snapshot.PresentCount</dt><dd>present</dd></div>
                                    <div><dt>@snapshot.LateCount</dt><dd>late</dd></div>
                                    <div><dt>@snapshot.AbsentCount</dt><dd>absent</dd></div>
                                    <div class="capacity"><dt>of</dt><dd>@session.Students.Count</dd></div>
                                </dl>
                                <div class="session-actions">
                                    <a class="attendance-link" href="@($"attendance/{session.Id}")">Attendance</a>
                                    <button type="button" disabled title="Exam launch is not available yet" aria-label="Start exam (not available yet)">Start exam</button>
                                </div>
                            </footer>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private static readonly TimeSpan PhilippineOffset = TimeSpan.FromHours(8);
    private IReadOnlyList<AttendanceSessionSnapshot> _sessions = [];
    private bool _isLoading;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        if (!ProctorSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        await LoadSessionsAsync();
    }

    private async Task LoadSessionsAsync()
    {
        if (ProctorSession.Proctor is not { } proctor)
        {
            return;
        }

        _isLoading = true;
        _loadError = null;
        try
        {
            _sessions = await AttendanceService.LoadAssignedAsync(proctor.Id);
        }
        catch
        {
            _sessions = [];
            _loadError = "Assigned sessions could not be loaded.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string FormatSchedule(AttendanceSessionDefinition session)
    {
        var start = session.StartsAtUtc.ToOffset(PhilippineOffset);
        var end = session.EndsAtUtc.ToOffset(PhilippineOffset);
        return $"{start:hh:mm tt} – {end:hh:mm tt}";
    }

    private static string FormatDate(DateTimeOffset startsAtUtc) =>
        startsAtUtc.ToOffset(PhilippineOffset).ToString("MMM d, yyyy");
}
