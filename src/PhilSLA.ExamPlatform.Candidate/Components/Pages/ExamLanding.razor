@page "/exam"
@layout LoginLayout
@implements IDisposable
@inject CandidateSessionState CandidateSession
@inject IDeviceReadinessService DeviceReadiness
@inject IExamAssignmentProvider ExamAssignmentProvider
@inject NavigationManager Navigation

<PageTitle>Exam Readiness | PhilSLA Exam Platform</PageTitle>

@if (CandidateSession.Candidate is not null && _assignment is not null)
{
    <main class="exam-readiness" aria-labelledby="readiness-title">
        <header class="candidate-summary">
            <div class="summary-copy">
                <div class="status-badges" aria-label="Candidate and exam status">
                    <span class="status-badge accepted">Accepted</span>
                    <span class="status-badge scheduled">Exam scheduled</span>
                </div>

                <div class="candidate-greeting">
                    <div class="candidate-avatar" aria-hidden="true">@CandidateInitials</div>
                    <div>
                        <h1 id="readiness-title">
                            Mabuhay, @CandidateSession.Candidate.FirstName!
                        </h1>
                        <p>@_assignment.Title</p>
                    </div>
                </div>
            </div>

            <div class="candidate-actions">
                <div class="candidate-id">
                    <span>Candidate ID</span>
                    <strong>@CandidateCode</strong>
                </div>
                <button class="logout-button"
                        type="button"
                        data-testid="logout"
                        @onclick="LogOut">
                    Sign out
                </button>
            </div>
        </header>

        <div class="readiness-layout">
            <section class="waiting-card" aria-labelledby="waiting-title">
                <div class="clock-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <circle cx="12" cy="12" r="8" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                </div>

                <h2 id="waiting-title">Wait for authorization to start the exam</h2>
                <p class="waiting-description">
                    Your device is being checked before the examination can begin.
                    Keep this application open.
                </p>

                <dl class="exam-details">
                    <div>
                        <dt>Date</dt>
                        <dd>@_assignment.Date.ToString("yyyy-MM-dd")</dd>
                    </div>
                    <div>
                        <dt>Center</dt>
                        <dd>@_assignment.Center</dd>
                    </div>
                    <div>
                        <dt>Room</dt>
                        <dd>@_assignment.Room</dd>
                    </div>
                    <div>
                        <dt>Proctor</dt>
                        <dd>@_assignment.Proctor</dd>
                    </div>
                </dl>

                <div class="authorization-state @AuthorizationClass"
                     role="status"
                     aria-live="polite">
                    <span aria-hidden="true"></span>
                    @AuthorizationMessage
                </div>
            </section>

            <aside class="readiness-sidebar" aria-label="Exam readiness status">
                <section class="diagnostics-card" aria-labelledby="diagnostics-title">
                    <div class="section-heading">
                        <svg aria-hidden="true" viewBox="0 0 24 24">
                            <rect x="5" y="5" width="14" height="14" rx="2" />
                            <path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3" />
                        </svg>
                        <h2 id="diagnostics-title">Computer &amp; tech check</h2>
                    </div>

                    <div class="diagnostic-list" aria-live="polite">
                        <div class="diagnostic-row">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <rect x="3" y="7" width="18" height="12" rx="2" />
                                <path d="M8 7l1.5-2h5L16 7M12 11a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
                            </svg>
                            <div>
                                <strong>Camera</strong>
                                <span>@CheckMessage(_readiness?.Camera)</span>
                            </div>
                            <span class="check-status @CheckClass(_readiness?.Camera)">
                                @CheckLabel(_readiness?.Camera)
                            </span>
                        </div>

                        <div class="diagnostic-row">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <rect x="9" y="3" width="6" height="11" rx="3" />
                                <path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6" />
                            </svg>
                            <div>
                                <strong>Microphone</strong>
                                <span>@CheckMessage(_readiness?.Microphone)</span>
                            </div>
                            <span class="check-status @CheckClass(_readiness?.Microphone)">
                                @CheckLabel(_readiness?.Microphone)
                            </span>
                        </div>

                        <div class="diagnostic-row">
                            <svg aria-hidden="true" viewBox="0 0 24 24">
                                <path d="M4 10a12 12 0 0 1 16 0M7 13a8 8 0 0 1 10 0M10 16a4 4 0 0 1 4 0" />
                                <circle cx="12" cy="19" r="1" />
                            </svg>
                            <div>
                                <strong>Network</strong>
                                <span>@CheckMessage(_readiness?.Network)</span>
                            </div>
                            <span class="check-status @CheckClass(_readiness?.Network)">
                                @CheckLabel(_readiness?.Network)
                            </span>
                        </div>
                    </div>

                    <button class="diagnostics-button"
                            type="button"
                            data-testid="run-diagnostics"
                            disabled="@IsBusy"
                            @onclick="RunDiagnosticsAndAuthorizeAsync">
                        @(IsBusy ? "Diagnostics in progress..." : "Run full diagnostics")
                    </button>
                </section>

                <section class="progress-card" aria-labelledby="progress-title">
                    <h2 id="progress-title">Exam readiness</h2>
                    <ol class="progress-list">
                        <li class="complete">
                            <span aria-hidden="true">✓</span>
                            <div>
                                <strong>Signed in</strong>
                                <small>Done</small>
                            </div>
                        </li>
                        <li class="@DeviceStepClass">
                            <span aria-hidden="true">@DeviceStepIcon</span>
                            <div>
                                <strong>Device check</strong>
                                <small>@DeviceStepText</small>
                            </div>
                        </li>
                        <li class="@AuthorizationStepClass">
                            <span aria-hidden="true">@AuthorizationStepIcon</span>
                            <div>
                                <strong>Authorization</strong>
                                <small>@AuthorizationStepText</small>
                            </div>
                        </li>
                        <li>
                            <span aria-hidden="true">4</span>
                            <div>
                                <strong>Examination</strong>
                                <small>Waiting</small>
                            </div>
                        </li>
                        <li>
                            <span aria-hidden="true">5</span>
                            <div>
                                <strong>Submission received</strong>
                                <small>Waiting</small>
                            </div>
                        </li>
                    </ol>
                </section>
            </aside>
        </div>
    </main>
}

@code {
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private ExamAssignment? _assignment;
    private DeviceReadinessReport? _readiness;
    private bool _isChecking;

    private bool IsBusy => _isChecking;

    private string CandidateInitials
    {
        get
        {
            var candidate = CandidateSession.Candidate;
            return candidate is null
                ? string.Empty
                : $"{candidate.FirstName[0]}{candidate.LastName[0]}".ToUpperInvariant();
        }
    }

    private string CandidateCode
    {
        get
        {
            var candidate = CandidateSession.Candidate;
            return candidate is null
                ? string.Empty
                : $"CAND-{candidate.Id.ToString("N")[..8].ToUpperInvariant()}";
        }
    }

    private string AuthorizationMessage => (_isChecking, _readiness?.CanStartExam) switch
    {
        (true, _) => "Running device diagnostics...",
        (_, true) => "Device checks passed. Automatic start is paused.",
        (_, false) => "Resolve failed checks to continue.",
        _ => "Preparing device diagnostics..."
    };

    private string AuthorizationClass =>
        _readiness is { CanStartExam: false } ? "blocked" : string.Empty;

    private string DeviceStepClass => (_isChecking, _readiness?.CanStartExam) switch
    {
        (true, _) => "current",
        (_, true) => "complete",
        (_, false) => "attention",
        _ => string.Empty
    };

    private string DeviceStepIcon => _readiness?.CanStartExam == true ? "✓" : "2";
    private string DeviceStepText => (_isChecking, _readiness?.CanStartExam) switch
    {
        (true, _) => "Checking",
        (_, true) => "Done",
        (_, false) => "Action required",
        _ => "Waiting"
    };

    private string AuthorizationStepClass => string.Empty;
    private string AuthorizationStepIcon => "3";
    private string AuthorizationStepText =>
        _readiness?.CanStartExam == true ? "Paused for testing" : "Waiting";

    protected override async Task OnInitializedAsync()
    {
        if (!CandidateSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        _assignment = await ExamAssignmentProvider.GetAssignmentAsync(
            _lifetimeCancellation.Token);
        await RunDiagnosticsAndAuthorizeAsync();
    }

    private async Task RunDiagnosticsAndAuthorizeAsync()
    {
        if (IsBusy)
        {
            return;
        }

        _isChecking = true;
        _readiness = null;

        try
        {
            _readiness = await DeviceReadiness.CheckAsync(
                _lifetimeCancellation.Token);
            _isChecking = false;

            if (!_readiness.CanStartExam)
            {
                return;
            }
        }
        catch (OperationCanceledException)
            when (_lifetimeCancellation.IsCancellationRequested)
        {
        }
        finally
        {
            _isChecking = false;
        }
    }

    private static string CheckMessage(ReadinessCheck? check)
    {
        return check?.Message ?? "Checking device...";
    }

    private static string CheckLabel(ReadinessCheck? check)
    {
        return check?.Status switch
        {
            ReadinessStatus.Ready => "Ready",
            ReadinessStatus.Warning => "Attention",
            ReadinessStatus.Failed => "Action needed",
            ReadinessStatus.Unavailable => "Unavailable",
            _ => "Checking"
        };
    }

    private static string CheckClass(ReadinessCheck? check)
    {
        return check?.Status switch
        {
            ReadinessStatus.Ready => "ready",
            ReadinessStatus.Warning => "warning",
            ReadinessStatus.Failed or ReadinessStatus.Unavailable => "failed",
            _ => "checking"
        };
    }

    private void LogOut()
    {
        _lifetimeCancellation.Cancel();
        CandidateSession.SignOut();
        Navigation.NavigateTo("/", replace: true);
    }

    public void Dispose()
    {
        _lifetimeCancellation.Cancel();
        _lifetimeCancellation.Dispose();
    }
}
